# TechPartner Platform Environment Configuration

# 🔧 Google Cloud Configuration
PROJECT_ID=glossy-agency-448211-s4
REGION=us-central1
SERVICE_NAME=techpartner-site

# 🌍 Environment URLs
PRODUCTION_URL=https://techpartner-site-flxd6wf2jq-uc.a.run.app
STAGING_URL=https://techpartner-site-staging-flxd6wf2jq-uc.a.run.app

# 📊 Resource Limits
PRODUCTION_MEMORY=2Gi
PRODUCTION_CPU=2
PRODUCTION_MAX_INSTANCES=10

